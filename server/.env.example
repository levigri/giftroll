# Fastify Server Port
PORT=3000

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/giftroll?schema=public"

# Telegram Bot Token from @BotFather
BOT_TOKEN="your_telegram_bot_token"

# Webhook domain (for Railway / ngrok)
WEBHOOK_URL="https://your-server-url.railway.app"

# TON wallet address to receive Gram payments (set the real wallet address)
TON_RECEIVER_ADDRESS=""

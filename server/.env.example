# Fastify Server Port
PORT=3000

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/giftroll?schema=public"

# Telegram Bot Token from @BotFather
BOT_TOKEN="your_telegram_bot_token"

# Webhook domain (for Railway / ngrok)
WEBHOOK_URL="https://your-server-url.railway.app"

# TON wallet address to receive Gram payments (set the real wallet address)
TON_RECEIVER_ADDRESS=""

# MTProto receiving account (configure TELEGRAM_SESSION locally; never commit it)
# TELEGRAM_API_ID=your_telegram_api_id
# TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION=""

# Telegram user ID that receives NFT withdrawal requests (optional)
# ADMIN_ID=123456789
